{
  "name": "latex-math-to-svg",
  "version": "1.0.0",
  "description": "CLI: TeX/LaTeX math to vector SVG using MathJax 3",
  "type": "module",
  "bin": {
    "latextosvg": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "build:app": "vite build",
    "cap:sync": "npm run build:app && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "latex",
    "math",
    "svg",
    "mathjax"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/share": "^7.0.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  }
}
